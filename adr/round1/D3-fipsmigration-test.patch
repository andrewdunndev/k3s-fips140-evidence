+// expectMode checks that every k3s process, server and agent, runs with the given GODEBUG mode
+func expectMode(mode string) {
+	for _, server := range tc.Servers {
+		Expect(processGODEBUG(server, "k3s")).To(ContainSubstring("fips140=" + mode))
+	}
+	for _, agent := range tc.Agents {
+		Expect(processGODEBUG(agent, "k3s-agent")).To(ContainSubstring("fips140=" + mode))
+	}
+}
